-- 2. SLIDE IN ANIMATION
local targetPosition = UDim2.new(0, 772, 0, -12)

local slideInTween = TweenService:Create(
    mainBtn,
    TweenInfo.new(
        0.8,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    ),
    { Position = targetPosition }
)

slideInTween:Play()

-- 3. SHOULDER CAMERA OFFSET (instant snap)
local function setShoulderOffset(offset)
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.CameraOffset = offset
    end
end

-- Get the currently equipped tool (returns nil if none or if it's blacklisted)
local function getActiveTool()
    local char = player.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return nil end
    -- Check blacklist (case-insensitive)
    if blacklistedTools[string.lower(tool.Name)] then
        return nil
    end
    return tool
end

-- 4. TOOL WATCHER
local function updateShoulderState()
    if isArmed and getActiveTool() then
        if not shoulderActive then
            setShoulderOffset(Vector3.new(1.5, 0, 0))
            shoulderActive = true
        end
    else
        if shoulderActive then
            setShoulderOffset(Vector3.new(0, 0, 0))
            shoulderActive = false
        end
    end
end

local function watchCharacter(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            updateShoulderState()
        end
    end)
    
    char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then
            updateShoulderState()
        end
    end)
    
    updateShoulderState()
end

if player.Character then
    watchCharacter(player.Character)
end

player.CharacterAdded:Connect(function(char)
    watchCharacter(char)
end)

-- 5. BUTTON HANDLER (Armed toggle)
mainBtn.MouseButton1Click:Connect(function()
    isArmed = not isArmed
    
    if isArmed then
        mainBtn.Text = "ARMED"
        updateShoulderState()
    else
        mainBtn.Text = "cl6 right click"
        setShoulderOffset(Vector3.new(0, 0, 0))
        shoulderActive = false
    end
end)
